# Copy to kiosk.env and edit. kiosk.env is git-ignored.

# The one Yahoo page shown as the Fantasy screen. Open your league's Matchup page in a
# normal browser once and paste its address here. The default below is a best guess
# built from the league ID and may need correcting.
YAHOO_MATCHUP_URL="https://football.fantasysports.yahoo.com/f1/46800/matchup"

# Ports and browser profile (defaults shown).
# DASHBOARD_PORT=8080
# DASHBOARD_DEBUG_PORT=9222
# DASHBOARD_CONTROLLER_PORT=8081
# DASHBOARD_PROFILE="$HOME/.config/wall-dashboard-chrome"
